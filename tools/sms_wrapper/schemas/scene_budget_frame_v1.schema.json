{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scene_budget_frame_v1",
  "description": "Metrica de orcamento de VBlank por frame de cena. Recusa valores 'estimados', exigindo metodo de medicao.",
  "type": "object",
  "required": ["scene", "frame_id", "bytes_vblank", "method"],
  "properties": {
    "scene": {"type": "string"},
    "frame_id": {"type": "integer"},
    "bytes_vblank": {"type": "integer", "description": "bytes transferidos no VBlank neste frame"},
    "method": {"type": "string", "description": "como foi medido; 'estimado' PROIBIDO (§9)"},
    "sprites_per_line_peak": {"type": "integer", "maximum": 8},
    "tiles_unique": {"type": "integer", "maximum": 256}
  },
  "allOf": [{"not": {"properties": {"method": {"const": "estimado"}, "required": ["method"]}}}]
}
