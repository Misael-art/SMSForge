  "required": ["token", "scope", "ceiling", "approved_by", "date"],
  "properties": {
    "token": {"enum": ["aaa", "60fps", "50fps", "pixel_perfect", "release"]},
    "scope": {"type": "string"},
    "ceiling": {"type": "string", "description": "limite EXATO do que o claim cobre"},
    "approved_by": {"type": "string", "description": "humano responsavel"},
    "date": {"type": "string"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  }
}
