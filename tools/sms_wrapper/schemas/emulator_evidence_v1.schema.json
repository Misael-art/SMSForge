{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "emulator_evidence_v1",
  "type": "object",
  "required": ["project", "rom", "screenshot", "informative"],
  "properties": {
    "project": {"type": "string"},
    "rom": {"type": "string"},
    "screenshot": {"type": "string"},
    "informative": {"type": "boolean", "description": "false = captura branca/vazia REPROVADA"},
    "detail": {"type": "string"},
    "tool": {"enum": ["openmsx", "emulicious", "meka"]},
    "input_script": {"type": "string"},
    "fps_measured": {"type": ["number", "null"]},
    "chain_of_custody": {"type": "array", "items": {"type": "string"}}
  }
}
